[Unit]
Description=Varynth API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=varynth
Group=varynth
WorkingDirectory=/opt/varynth/src/api
EnvironmentFile=/etc/varynth/api.env
ExecStart=/opt/varynth/src/api/target/release/varynth-api
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/varynth

[Install]
WantedBy=multi-user.target
