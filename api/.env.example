DATABASE_URL=postgres://varynth:varynth@127.0.0.1:5432/varynth
JWT_SECRET=change-me-to-a-long-random-string-32b
WEB_ORIGIN=http://127.0.0.1:3000
# Set this to the public https:// URL in production: session cookies then get
# the __Host- prefix and Secure, and every response carries HSTS
# (Strict-Transport-Security). An http:// URL keeps local development
# cookies plain and non-secure.
VARYNTH_API_PUBLIC_URL=http://127.0.0.1:8080
# Comma-separated IPs or CIDRs of reverse proxies whose X-Forwarded-For header
# is trusted. Only the last hop is used, and only when the socket peer matches.
# Leave empty to always use the socket peer address (the safe default).
VARYNTH_TRUSTED_PROXIES=
BIND_ADDR=127.0.0.1:8080
# Leave stub on until WORKER_GATEWAY_KEY is set. The five gateway URLs are the API default.
VARYNTH_STUB_UPSTREAM=0
VARYNTH_ENABLE_PUBLIC_PLACEHOLDERS=1
# Self-service plan changes (POST /v1/me/subscription) work only when this is 1.
# Without it the endpoint answers 501 and no charge or plan change happens.
VARYNTH_BILLING_STUB=0
WORKER_GATEWAY_KEY=
WORKER_GATEWAYS=
PARALLEL_API_KEY=
PARALLEL_API_KEY_2=
PARALLEL_API_KEY_3=
PARALLEL_API_KEY_4=
EXA_API_KEY=
EXA_API_KEY_2=
EXA_API_KEY_3=
EXA_API_KEY_4=
FIRECRAWL_API_KEY=
FIRECRAWL_API_KEY_2=
FIRECRAWL_API_KEY_3=
FIRECRAWL_API_KEY_4=
VARYNTH_PRO_EMAILS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
